#include <iostream>
#include <string>

using namespace std;

struct Process {
string pid;
int arrival_time;
int burst_time;
int waiting_time;
int turnaround_time;
};

void sortByArrival(Process proc[], int n) {
for(int i = 0; i < n-1; i++) {
for(int j = i+1; j < n; j++) {
if(proc[j].arrival_time < proc[i].arrival_time) {
Process temp = proc[i];
proc[i] = proc[j];
proc[j] = temp;
}
}
}
}

int main() {
int n;
cout << "Enter the number of processes: ";
cin >> n;

Process proc[n];

// Input Details
for(int i = 0; i < n; i++) {
cout << "Enter Process ID: ";
cin >> proc[i].pid;
cout << "Enter Arrival Time: ";
cin >> proc[i].arrival_time;
cout << "Enter Burst Time: ";
cin >> proc[i].burst_time;
proc[i].waiting_time = 0;
proc[i].turnaround_time = 0;
}

//Arrival time
sortByArrival(proc, n);

int completion_time = 0;
float total_waiting_time = 0;
float total_turnaround_time = 0;

//Waiting time and Turnaround time
for(int i = 0; i < n; i++) {
if(i == 0) {

proc[i].waiting_time = 0;
completion_time = proc[i].arrival_time + proc[i].burst_time;
} else {
if(proc[i].arrival_time > completion_time) {

completion_time = proc[i].arrival_time;
}
proc[i].waiting_time = completion_time - proc[i].arrival_time;
completion_time += proc[i].burst_time;
}
proc[i].turnaround_time = proc[i].waiting_time + proc[i].burst_time;

total_waiting_time += proc[i].waiting_time;
total_turnaround_time += proc[i].turnaround_time;
}

// Display
cout << "\nProcess ID\tArrival Time\tBurst Time\tWaiting Time\tTurnaround Time\n";
for(int i = 0; i < n; i++) {
cout << proc[i].pid << "\t\t"
<< proc[i].arrival_time << "\t\t"
<< proc[i].burst_time << "\t\t"
<< proc[i].waiting_time << "\t\t"
<< proc[i].turnaround_time << "\n";
}

cout << "\nAverage Waiting Time = " << total_waiting_time / n << "\n";
cout << "Average Turnaround Time = " << total_turnaround_time / n << "\n";

return 0;
}
